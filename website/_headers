/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/*.html
  Cache-Control: public, max-age=60, must-revalidate

/
  Cache-Control: public, max-age=60, must-revalidate

/privacy
  Cache-Control: public, max-age=60, must-revalidate

/support
  Cache-Control: public, max-age=60, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800, immutable
